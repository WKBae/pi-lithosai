{
  "name": "pi-lithosai",
  "version": "0.1.2",
  "description": "LithosAI model provider for Pi",
  "type": "module",
  "license": "MIT",
  "author": "William K. Bae",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WKBae/pi-lithosai.git"
  },
  "homepage": "https://github.com/WKBae/pi-lithosai#readme",
  "bugs": "https://github.com/WKBae/pi-lithosai/issues",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "lithosai",
    "llm",
    "provider",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/provider/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/chord": "1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
